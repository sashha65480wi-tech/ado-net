@model List<Part>
@{ ViewData["Title"] = "Поиск запчастей"; }
<h1 class="mb-4">Каталог автозапчастей</h1>
<form asp-controller="Parts" asp-action="Search" method="get" class="row g-2 mb-4">
<div class="col-md-8"><input type="text" name="query" value="@ViewBag.Query" class="form-control" placeholder="Название или артикул запчасти..." /></div>
<div class="col-auto"><button class="btn btn-primary" type="submit">Найти</button></div>
<div class="col-auto"><a asp-action="Index" class="btn btn-outline-secondary">Показать все</a></div>
</form>
@if (Model.Count == 0) { <div class="alert alert-warning">Запчасти не найдены.</div> }
else { <p>Найдено записей: <b>@Model.Count</b></p>
<table class="table table-striped table-bordered"><thead class="table-dark"><tr><th>ID</th><th>Название</th><th>Артикул</th><th>Цена</th><th>Остаток</th></tr></thead><tbody>
@foreach (var p in Model) { <tr><td>@p.Id</td><td>@p.Name</td><td>@p.Article</td><td>@p.Price.ToString("0.00")</td><td>@p.Stock</td></tr> }
</tbody></table> }